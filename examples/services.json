              ],
              "emb": [
                {
                  "text": "query → vector"
                }
              ]
            },
            "say": "The query is embedded — by a model loaded in the process itself, or a remote embeddings service."
          },
          {
            "edges": {
              "edge": "http-mem",
              "data": "4-way search"
            },
            "show": {
              "mem": [
                {
                  "tag": "world",
                  "text": "Alice joined Google",
                  "meta": "Mar 2026",
                  "mark": "✓"
                }
              ]
            },
            "say": "The four searches run as queries against PostgreSQL, where every bank lives."
          },
          {
            "edges": {
              "edge": "http-emb",
