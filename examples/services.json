                {
                  "tag": "model",
                  "tone": "orange",
                  "text": "Team overview",
                  "mark": "↻"
                }
              ],
              "iworker": [
                {
                  "text": "refresh_mental_model op_9c4",
                  "mono": true,
                  "mark": "✓"
                }
              ]
            },
            "say": "Any worker can run any task: they share the package, the image and the database, so you add more to scale.",
            "ms": 3000
          }
        ]
      },
      {
        "label": "recall · sync",
        "flow": [
          {
            "edges": {
              "edge": "app-http",
              "data": "recall()"
            },
            "show": {
              "app": [
                {
                  "tag": "recall",
                  "tone": "gray",
                  "text": "“Where does Alice work?”"
                }
              ]
            },
            "say": "Later, a recall. Like reflect and any read, it is answered inside the API process. Nothing is queued."
          },
          {
            "edges": {
              "edge": "http-emb",
