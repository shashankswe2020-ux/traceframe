{
  "$schema": "../schema.json",
  "title": "OAuth 2.0 Authorization Code with PKCE",
  "props": {
    "speed": 1700,
    "layout": {
      "gap": 110,
      "children": [
        {
          "label": "Resource server",
          "children": [
            { "id": "api", "label": "Orders API", "sub": "orders:read", "lines": 2, "width": 210 }
          ]
        },
        {
          "label": "User device",
          "direction": "column",
          "gap": 36,
          "children": [
            { "id": "user", "label": "User", "sub": "signs in" },
            { "id": "app", "label": "Mobile app", "sub": "public client", "lines": 4, "width": 210 },
            { "id": "vault", "label": "Secure storage", "sub": "refresh token", "shape": "store", "lines": 2, "width": 210 }
          ]
        },
        {
          "label": "Authorization server",
          "direction": "column",
          "gap": 36,
          "children": [
            { "id": "authorize", "label": "Authorize", "sub": "/authorize", "lines": 3, "width": 220 },
            { "id": "login", "label": "Login + consent", "sub": "browser session", "lines": 2, "width": 220 },
            { "id": "grant", "label": "Grant store", "sub": "code + challenge", "shape": "store", "lines": 3, "width": 220 },
            { "id": "token", "label": "Token endpoint", "sub": "/oauth/token", "lines": 2, "width": 220 }
          ]
        }
      ]
    },
    "edges": [
      { "id": "start", "from": "user", "to": "app", "label": "sign in" },
      { "id": "auth", "from": "app", "to": "authorize", "label": "challenge / code" },
      { "id": "prompt", "from": "authorize", "to": "login", "label": "authenticate" },
      { "id": "record", "from": "login", "to": "grant", "label": "approve" },
      { "id": "exchange", "from": "app", "to": "token", "label": "POST /token" },
      { "id": "verify", "from": "token", "to": "grant", "label": "SHA-256" },
      { "id": "save", "from": "app", "to": "vault", "label": "keychain" },
      { "id": "request", "from": "app", "to": "api", "label": "Bearer" }
    ],
    "steps": [
      {
        "label": "authorize",
        "flow": [
          {
            "edges": "start",
            "show": { "app": [{ "tag": "pkce", "tone": "blue", "text": "verifier: sX4...9Q", "mono": true }, { "text": "challenge = SHA256(verifier)", "mono": true }] },
            "say": "The app creates a one-time verifier and sends only its hash."
          },
          { "edges": { "edge": "auth", "data": "challenge" }, "say": "The system browser opens the authorization request." },
          { "edges": "prompt", "show": { "login": [{ "tag": "user", "tone": "gray", "text": "ada@example.com" }, { "tag": "scope", "tone": "purple", "text": "orders:read", "mark": "allow" }] }, "say": "Ada authenticates and approves the requested scope." },
          { "edges": "record", "show": { "grant": [{ "tag": "code", "tone": "green", "text": "c_8f31", "mono": true }, { "text": "challenge: q8K...2M", "meta": "expires 60 s", "mono": true }] }, "say": "The server binds a short-lived code to the PKCE challenge." },
          { "edges": { "edge": "auth", "back": true, "data": "c_8f31" }, "say": "Only the authorization code returns through the app link." }
        ]
      },
      {
        "label": "exchange code",
        "flow": [
          { "edges": { "edge": "exchange", "data": "code + verifier" }, "show": { "app": [{ "tag": "code", "tone": "green", "text": "c_8f31", "mono": true }, { "tag": "secret", "tone": "orange", "text": "verifier: sX4...9Q", "mono": true }] }, "say": "The app proves it owns the verifier used to start login." },
          { "edges": "verify", "show": { "grant": [{ "tag": "match", "tone": "green", "text": "SHA256(verifier)", "meta": "challenge matches", "mark": "valid" }] }, "say": "The token endpoint hashes the verifier and matches the stored challenge." },
          { "edges": { "edge": "exchange", "back": true, "data": "access + refresh" }, "show": { "app": [{ "tag": "access", "tone": "blue", "text": "expires in 15 min" }, { "tag": "refresh", "tone": "purple", "text": "rotating token" }] }, "say": "The consumed code becomes scoped access and refresh tokens." },
          { "edges": "save", "show": { "vault": [{ "tag": "keychain", "tone": "gray", "text": "refresh token", "mark": "saved" }] }, "say": "Only the refresh token persists in operating-system secure storage." },
          { "edges": { "edge": "request", "data": "access token" }, "show": { "api": [{ "tag": "200", "tone": "green", "text": "Ada's orders", "meta": "scope accepted" }] }, "say": "The short-lived access token authorizes the API request." }
        ]
      },
      {
        "label": "refresh safely",
        "flow": [
          { "light": ["app"], "show": { "app": [{ "tag": "401", "tone": "orange", "text": "access token expired" }] }, "say": "Later, the access token expires without interrupting Ada." },
          { "edges": { "edge": "save", "back": true, "data": "rt_01" }, "show": { "vault": [{ "tag": "old", "tone": "gray", "text": "rt_01", "mono": true }] }, "say": "The app reads the refresh token from secure storage." },
          { "edges": { "edge": "exchange", "data": "refresh token" }, "say": "The app presents the refresh token once." },
          { "edges": { "edge": "exchange", "back": true, "data": "rotated pair" }, "show": { "app": [{ "tag": "access", "tone": "blue", "text": "new 15 min token" }, { "tag": "refresh", "tone": "purple", "text": "rt_02", "mono": true }] }, "say": "Rotation issues a new pair and invalidates the old refresh token." },
          { "edges": "save", "show": { "vault": [{ "tag": "current", "tone": "green", "text": "rt_02", "mono": true, "mark": "saved" }] }, "say": "Secure storage atomically replaces the previous refresh token." }
        ]
      }
    ]
  }
}